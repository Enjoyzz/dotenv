{
    "name": "enjoys/dotenv",
    "description": "Registers environment variables from a .env file",
    "keywords": [
        "environment",
        "env",
        "dotenv"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Enjoys\\Dotenv\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "require": {
        "php": "8.3 - 8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^2.1",
        "infection/infection": "^0.29",
        "symfony/var-dumper": "^7.0"
    },
    "scripts": {
        "psalm": "docker run -v $PWD:/app --rm -it ghcr.io/danog/psalm:latest /composer/vendor/bin/psalm --no-cache",
        "phpstan": "phpstan analyze src --level 10",
        "infection": "XDEBUG_MODE=coverage infection -j2 --configuration=infection.json",
        "test": "phpunit",
        "static": [
            "@test",
            "@psalm",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
